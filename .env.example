# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงสำหรับทดสอบในเครื่อง (ใช้กับ `vercel dev`)
# บน Vercel จริง ให้ตั้งค่าตัวแปรเหล่านี้ใน Project Settings -> Environment Variables แทน

# connection string จาก Neon หรือ Supabase (Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# API key จาก Google Cloud Console (เปิดใช้งาน Cloud Vision API แล้วสร้าง API key)
GOOGLE_VISION_API_KEY=your-google-cloud-vision-api-key
